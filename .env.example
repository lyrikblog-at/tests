# Copy this file to .env and fill in your values

# Target website to monitor
TARGET_URL=https://www.lyrikblog.at

# Playwright timeout in milliseconds
REQUEST_TIMEOUT_MS=15000

# Run browser headless (true) or with visible UI (false)
HEADLESS=false

# PostgreSQL connection
DB_HOST=wuffi.lyrikblog.pri
DB_PORT=5432
DB_NAME=uptime_monitor
DB_USER=appuser
DB_PASSWORD=appuser!

# Optional: how long to wait for DB connection (ms)
DB_CONNECT_TIMEOUT_MS=5000
